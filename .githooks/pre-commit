#!/bin/sh
# Regenerate the derived database files. Fail loudly: a stale db_meta.json
# signature silently breaks database auto-update for users.
set -e

if command -v poetry >/dev/null 2>&1; then
    run() { poetry run "$@"; }
elif [ -x .venv/bin/python ]; then
    run() { c=$1; shift; if [ -x ".venv/bin/$c" ]; then ".venv/bin/$c" "$@"; else "$c" "$@"; fi; }
elif [ -x .venv/Scripts/python.exe ]; then
    run() { c=$1; shift; if [ -x ".venv/Scripts/$c.exe" ]; then ".venv/Scripts/$c.exe" "$@"; else "$c" "$@"; fi; }
else
    echo 'pre-commit: need poetry or .venv — run `python scripts/setup_manager.py install`' >&2
    exit 1
fi

echo 'Regenerating data.json and sites.md...'
run python -m utils.update_site_data

echo 'Regenerating db_meta.json...'
run python utils/generate_db_meta.py

git add perra/resources/db_meta.json
git add perra/resources/data.json
git add sites.md
